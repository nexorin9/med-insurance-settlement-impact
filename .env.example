# 医保结算清单取数影响分析 · 环境变量清单
#
# 复制为 .env 后由启动脚本 source 导出到进程环境，或直接在系统环境里设置。
# 工具**只从环境变量读凭据**，不读配置文件、不读命令行明文参数、不写日志。
# 本文件只含占位说明，不含任何真实值；.env 已被 .gitignore 排除。

# ---------- ① 院内 HIS / EMR 只读库（JDBC 只读，Oracle 方言为首版）----------
# 取数视图定义（all_views.text）与结算模块字段字典的唯一权威来源。
# 账号必须为只读账号；口令不写入连接串字面量。
HIS_DB_URL=jdbc:oracle:thin:@//<HOST>:<PORT>/<SID>
HIS_DB_USER=<READONLY_USER>
HIS_DB_PASSWORD=<PASSWORD>

# ---------- ② 院内接口管理平台（HTTP 出站：读 + 幂等回写）----------
# 回写走 POST {IFACE_REGISTRY_BASE_URL}/api/v1/interface-entries/{entry_id}/field-change-impacts
IFACE_REGISTRY_BASE_URL=http://<HOST>:<PORT>
IFACE_REGISTRY_TOKEN=<BEARER_TOKEN>

# ---------- ③ 模型端点（OpenAI-compatible，单一 ModelGateway，不绑定厂商 SDK）----------
# 用途只有两件：改动语义归因（是否同义）、生成可粘给厂商的中文说明草稿。
# 模型只产草稿，不推进 CONFIRMED / WRITTEN_BACK。
MODEL_BASE_URL=http://<HOST>:<PORT>
MODEL_API_KEY=<API_KEY>
MODEL_NAME=<MODEL_NAME>

# 模型读超时秒数。未设置时使用默认值 30，并在 doctor 自检里显式标出「使用了默认值」。
MODEL_TIMEOUT_SECONDS=30
